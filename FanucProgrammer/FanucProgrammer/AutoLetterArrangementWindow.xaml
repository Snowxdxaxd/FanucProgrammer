<Window x:Class="FanucProgrammer.AutoLetterArrangementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Автоматическое размещение букв" 
        Height="639" Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    
    <Window.Resources>
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10 5"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#005A9E"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#004578"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Панель управления (Слева) -->
        <StackPanel Grid.Column="0" Background="White" Margin="0,0,10,0">
            <Border Background="#2196F3" Padding="10">
                <TextBlock Text="Настройки текста" Foreground="White" FontWeight="Bold"/>
            </Border>

            <StackPanel>
                <TextBlock Text="Введите текст (лат.):" Margin="0,0,0,5"/>
                <TextBox x:Name="TxtInput" Height="80" TextWrapping="Wrap" 
                         AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                         TextChanged="Settings_Changed"/>

                <TextBlock Text="Масштаб букв:" Margin="0,15,0,5"/>
                <Slider x:Name="SldScale" Minimum="0.1" Maximum="3.0" Value="1.0" 
                        TickFrequency="0.1" IsSnapToTickEnabled="True"
                        ValueChanged="Settings_Changed"/>
                <TextBlock Text="{Binding ElementName=SldScale, Path=Value, StringFormat={}{0:F1}x}" 
                           HorizontalAlignment="Right" Foreground="Gray"/>

                <TextBlock Text="Межстрочный интервал (мм):" Margin="0,10,0,5"/>
                <Slider x:Name="SldLineSpacing" Minimum="10" Maximum="100" Value="30" 
                        ValueChanged="Settings_Changed"/>

                <TextBlock Text="Межбуквенный интервал (мм):" Margin="0,10,0,5"/>
                <Slider x:Name="SldCharSpacing" Minimum="0" Maximum="20" Value="2" 
                        ValueChanged="Settings_Changed"/>

                <CheckBox x:Name="ChkCenterAlign" Content="Центрировать по горизонтали" 
                          Margin="0,20,0,0" Checked="Settings_Changed" Unchecked="Settings_Changed"/>

                <TextBlock Text="Высота письма Z (мм):" Margin="0,10,0,5"/>
                <Slider x:Name="SldZ" Minimum="-100" Maximum="100" Value="0" 
                         TickFrequency="5" IsSnapToTickEnabled="True" 
                         ValueChanged="Settings_Changed"/>   
                <TextBlock Text="{Binding ElementName=SldZ, Path=Value, StringFormat={}{0:F0} мм}" 
                          HorizontalAlignment="Right" Foreground="Gray"/>



                <TextBlock Text="Высота подъёма Z (мм):" Margin="0,10,0,5"/>
                <Slider x:Name="SldZRetract" Minimum="-100" Maximum="50" Value="-30" 
                         TickFrequency="5" IsSnapToTickEnabled="True" 
                         ValueChanged="Settings_Changed"/>
                <TextBlock Text="{Binding ElementName=SldZRetract, Path=Value, StringFormat={}{0:F0} мм}" 
                         HorizontalAlignment="Right" Foreground="Gray"/>


                <Button Content="Сгенерировать LS" Margin="0,30,0,0" Height="40"
                        Background="#4CAF50" Foreground="White" FontWeight="Bold"
                        Click="BtnGenerate_Click"/>

                

                <Button Content="ГТТ" Margin="0,5,0,0" Height="40"
                        Background="#9C27B0" Foreground="White" FontWeight="Bold"
                        Click="BtnExportGtt_Click"/>
                <Button Content="Выгрузить в KUKA" Margin="0,5,0,0" Height="40"
        Background="#FF5722" Foreground="White" FontWeight="Bold"
        Click="BtnExportKuka_Click"/>
                
            </StackPanel>
        </StackPanel>

        <!-- Область предпросмотра (Справа) -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Предпросмотр листа A4 (размеры в мм)" Margin="5" FontWeight="SemiBold"/>

            <Border Grid.Row="1" Background="#DDDDDD" BorderBrush="Gray" BorderThickness="1">
                <!-- Контейнер для масштабирования листа под размер окна -->
                <Viewbox Stretch="Uniform">
                    <!-- Canvas имитирует реальный лист A4 -->
                    <Canvas x:Name="SheetCanvas" Background="White" 
                            Width="210" Height="297">
                        <!-- Сетка -->
                        <Path Stroke="LightBlue" StrokeThickness="0.5" x:Name="GridPath"/>
                    </Canvas>
                </Viewbox>
            </Border>
        </Grid>
    </Grid>
</Window>