<Window x:Class="FanucProgrammer.PointsOnModelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Точки по модели - Fanuc Programmer" Height="850" Width="1400"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">
    <Window.Resources>
        <!-- Reuse modern styles similar to SimulateWindow -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#A52A2A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="4" 
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect Color="#40000000" Direction="270" ShadowDepth="2" BlurRadius="4" Opacity="0.3"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#A52A2A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#800000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlaceholderTextBox" TargetType="TextBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                            <TextBlock x:Name="PlaceholderTextBlock"
                               Text="{TemplateBinding Tag}"
                               Foreground="Gray"
                               Margin="5,0,0,0"
                               VerticalAlignment="Center"
                               Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="PlaceholderTextBlock" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="Text" Value="{x:Null}">
                                <Setter TargetName="PlaceholderTextBlock" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#20000000" Direction="270" ShadowDepth="3" BlurRadius="8" Opacity="0.2"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#2196F3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#FF8C00" Padding="20,15">
            <TextBlock Text="Точки по модели" 
                      FontSize="24" 
                      FontWeight="Bold" 
                      Foreground="White"/>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- 3D Viewport -->
            <Border Grid.Column="0" 
                   Background="#1A1A1A" 
                   Margin="10,10,5,10"
                   CornerRadius="8"
                   BorderThickness="1"
                   BorderBrush="#333"
                   MouseLeftButtonDown="Viewport3D_MouseLeftButtonDown"
                   MouseLeftButtonUp="Viewport3D_MouseLeftButtonUp"
                   MouseRightButtonDown="Viewport3D_MouseRightButtonDown"
                   MouseRightButtonUp="Viewport3D_MouseRightButtonUp"
                   MouseMove="Viewport3D_MouseMove"
                   MouseWheel="Viewport3D_MouseWheel">
                <Border.Effect>
                    <DropShadowEffect Color="#40000000" Direction="270" ShadowDepth="3" BlurRadius="8" Opacity="0.3"/>
                </Border.Effect>
                <Viewport3D x:Name="Viewport3D">
                    <Viewport3D.Camera>
                        <PerspectiveCamera x:Name="Camera" 
                                         Position="0,0,800" 
                                         LookDirection="0,0,-1" 
                                         UpDirection="0,1,0" 
                                         FieldOfView="45"/>
                    </Viewport3D.Camera>

                    <ModelVisual3D>
                        <ModelVisual3D.Content>
                            <Model3DGroup x:Name="SceneGroup">
                                <!-- Lighting -->
                                <AmbientLight Color="#CCCCCC"/>
                                <DirectionalLight Color="White" Direction="-1,-1,-1"/>
                                <DirectionalLight Color="#888888" Direction="1,1,-1"/>
                            </Model3DGroup>
                        </ModelVisual3D.Content>
                    </ModelVisual3D>
                </Viewport3D>
            </Border>

            <!-- Controls Panel -->
            <Border Grid.Column="1" 
                   Style="{StaticResource Card}"
                   Margin="5,10,10,10">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Cursor="">
                        <TextBlock Text="Управление камерой" 
                                  FontSize="18" 
                                  FontWeight="Bold" 
                                  Margin="0,0,0,15"
                                  Foreground="#333"/>

                        <TextBlock Text="Поворот по оси X:" 
                                  FontWeight="SemiBold" 
                                  Margin="0,0,0,5"/>
                        <Slider x:Name="RotationXSlider" 
                               Minimum="0" 
                               Maximum="360" 
                               Value="0" 
                               TickFrequency="10"
                               ValueChanged="RotationXSlider_ValueChanged"
                               Margin="0,0,0,15"/>

                        <TextBlock Text="Поворот по оси Y:" 
                                  FontWeight="SemiBold" 
                                  Margin="0,0,0,5"/>
                        <Slider x:Name="RotationYSlider" 
                               Minimum="0" 
                               Maximum="360" 
                               Value="0" 
                               TickFrequency="10"
                               ValueChanged="RotationYSlider_ValueChanged"
                               Margin="0,0,0,15"/>

                        <TextBlock Text="Управление мышью:" 
                                  FontWeight="SemiBold" 
                                  Margin="0,0,0,5"/>
                        

                        <TextBlock Text="Позиция камеры:" 
                                  FontWeight="SemiBold" 
                                  Margin="0,10,0,5"/>
                        <TextBlock x:Name="CameraPositionText" 
                                   FontSize="12" 
                                   Foreground="#444"/>

                        <Separator Margin="0,15,0,15"/>

                        <TextBlock Text="3D модель" 
                                  FontSize="16" 
                                  FontWeight="Bold" 
                                  Margin="0,0,0,10"
                                  Foreground="#333"/>
                        <Button x:Name="LoadModelButton"
                                Content="Загрузить модель (FBX)"
                                Style="{StaticResource ModernButton}"
                                Click="LoadModelButton_Click"/>

                        <Button x:Name="ShowObjectsPanelButton"
                                Content="Управление объектами"
                                Style="{StaticResource ModernButton}"
                                Margin="0,10,0,0"
                                Click="ShowObjectsPanelButton_Click"/>

                        <Button x:Name="AutoAttachAllButton"
                                Content="Автопривязка всех объектов"
                                Style="{StaticResource ModernButton}"
                                Margin="0,10,0,0"
                                Click="AutoAttachAllButton_Click"/>

                        <Button x:Name="CreatePointsButton"
                                Content="Создать точки по модели"
                                Style="{StaticResource ModernButton}"
                                Margin="0,10,0,0"
                                Click="CreatePointsButton_Click"/>

                        <Button x:Name="ClearFieldButton"
                                Content="Очистить поле"
                                Style="{StaticResource ModernButton}"
                                Margin="0,10,0,0"
                                Click="ClearFieldButton_Click" Cursor="Hand"/>

                        <Button x:Name="ResetSheetTransformButton" 
                                Content="Сбросить трансформации" 
                                Style="{StaticResource ModernButton}"
                                Margin="0,5" Click="ResetSheetTransformButton_Click"/>



                        <TextBlock Text="SVG параметры" 
                                  FontSize="16" 
                                  FontWeight="Bold" 
                                  Margin="0,15,0,10"
                                  Foreground="#333"/>

                        <Button Content="Load SVG"
                                Click="LoadSvgButton_Click"
                                Margin="0,0,0,10"
                                Style="{StaticResource ModernButton}"/>

                        <GroupBox Header="Трансформации листа и сетки" 
                                Margin="0,15,0,10">
                            <StackPanel>
                                <TextBlock Text="Смещение листа X:" Margin="0,5" Cursor=""/>
                                <TextBox x:Name="SheetOffsetXTextBox" Text="0" Margin="0,5"/>

                                <TextBlock Text="Смещение листа Y:" Margin="0,5"/>
                                <TextBox x:Name="SheetOffsetYTextBox" Text="0" Margin="0,5"/>

                                <TextBlock Text="Поворот листа (°):" Margin="0,5"/>
                                <TextBox x:Name="SheetRotationTextBox" Text="0" Margin="0,5"/>

                                <TextBlock Text="Масштаб листа:" Margin="0,5"/>
                                <TextBox x:Name="SheetScaleTextBox" Text="1.0" Margin="0,5"/>

                                <CheckBox x:Name="GridAttachedCheckBox" 
                                      Content="Привязать сетку к листу" 
                                      Margin="0,10,0,5"
                                      IsChecked="True" />

                                <CheckBox x:Name="ToggleGridInversionCheckBox" 
                                      Content="Инверсировать сетку" 
                                      Margin="0,10,0,5"
                                      Checked="ToggleGridInversionCheckBox_Checked"
                                      Unchecked="ToggleGridInversionCheckBox_Unchecked"/>     

                                <Button x:Name="ApplySheetTransformButton" 
                                    Content="Применить к листу" 
                                    Style="{StaticResource ModernButton}"
                                    Margin="0,5"/>
                                                </StackPanel>
                        </GroupBox>

                        

                        <TextBlock Text="Режим каллиграфии:" Grid.Row="6" Grid.Column="0" Margin="0,5"/>
                        <ComboBox x:Name="CalligraphyModeComboBox" Grid.Row="6" Grid.Column="1" Margin="0,5">
                            <ComboBoxItem Content="Однолинейное" Tag="SingleStroke" IsSelected="True"/>
                            <ComboBoxItem Content="Обводка контуром" Tag="OutlineFill"/>
                            <ComboBoxItem Content="Кистевое письмо" Tag="BrushStroke"/>
                        </ComboBox>

                        <TextBlock Text="Высота подъема (мм):" Grid.Row="7" Grid.Column="0" Margin="0,5"/>
                        <TextBox x:Name="CalligraphyLiftHeightTextBox" Grid.Row="7" Grid.Column="1" Text="5.0" Margin="0,5"/>

                        <TextBlock Text="Ширина штриха" Grid.Row="7" Grid.Column="0" Margin="0,5"/>
                        <TextBox x:Name="StrokeWidthVariationTextBox" 
                             Text="0.2" 
                             Width="100"
                             PreviewTextInput="NumberValidationTextBox">
                            <TextBox.ToolTip>
                                <TextBlock>
                                    Вариация ширины штриха (0.1 - 2.0)
                                    <LineBreak/>0.1 = R = 0° (вертикально вниз)
                                    <LineBreak/>1.0 = R = 45° (наклонно)
                                    <LineBreak/>2.0 = R = 90° (горизонтально вправо)
                                </TextBlock>
                            </TextBox.ToolTip>
                        </TextBox>

                        <CheckBox x:Name="EnableCalligraphyCheckBox" 
                              Content="Включить каллиграфический режим" 
                              Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="2" 
                              Margin="0,5" IsChecked="True"/>


                        <Button x:Name="ClearTextPointsButton" 
                            Content="Очистить текстовые точки" 
                            Click="ClearTextPointsButton_Click" 
                            Margin="0,10,0,0"
                            Style="{StaticResource ModernButton}"/>


                        <GroupBox Header="Текстовые точки" Margin="5,0,5,5">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="Смещение X:" Grid.Row="0" Grid.Column="0" Margin="5"/>
                                    <TextBox x:Name="TextOffsetXTextBox" Grid.Row="0" Grid.Column="1" Text="0" Margin="5"/>

                                    <TextBlock Text="Смещение Y:" Grid.Row="1" Grid.Column="0" Margin="5"/>
                                    <TextBox x:Name="TextOffsetYTextBox" Grid.Row="1" Grid.Column="1" Text="0" Margin="5"/>

                                    <TextBlock Text="Смещение Z:" Grid.Row="2" Grid.Column="0" Margin="5"/>
                                    <TextBox x:Name="TextOffsetZTextBox" Grid.Row="2" Grid.Column="1" Text="50" Margin="5"/>

                                    <TextBlock Text="Масштаб:" Grid.Row="3" Grid.Column="0" Margin="5"/>
                                    <TextBox x:Name="TextScaleTextBox" Grid.Row="3" Grid.Column="1" Text="1.0" Margin="5"/>

                                    <TextBlock Text="Поворот (°):" Grid.Row="4" Grid.Column="0" Margin="5"/>
                                    <TextBox x:Name="TextRotationTextBox" Grid.Row="4" Grid.Column="1" Text="0" Margin="5"/>

                                    <!-- Новые элементы управления для шага и инверсии -->
                                    <TextBlock Text="Шаг точек:" Grid.Row="5" Grid.Column="0" Margin="5"/>
                                    <TextBox x:Name="TextPointStepTextBox" Grid.Row="5" Grid.Column="1" Text="0.5" Margin="5"/>

                                    <TextBlock Text="Инверсия по X:" Grid.Row="6" Grid.Column="0" Margin="5"/>
                                    <CheckBox x:Name="TextInvertXCheckBox" Grid.Row="6" Grid.Column="1" Margin="5" HorizontalAlignment="Left"/>

                                    <TextBlock Text="Инверсия по Y:" Grid.Row="7" Grid.Column="0" Margin="5"/>
                                    <CheckBox x:Name="TextInvertYCheckBox" Grid.Row="7" Grid.Column="1" Margin="5" HorizontalAlignment="Left"/>

                                    <CheckBox x:Name="TextSeparateCharactersCheckBox" 
                                      Content="Раздельные символы" 
                                      Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2" 
                                      Margin="5" IsChecked="True"/>
                                </Grid>

                                <TextBlock Text="Режим написания:" Grid.Row="9" Grid.Column="0" Margin="5"/>
                                <ComboBox x:Name="TextModeComboBox" Grid.Row="9" Grid.Column="1" Margin="5">
                                    <ComboBoxItem Content="Обводка контуром" Tag="Contour"/>
                                    <ComboBoxItem Content="Центральная линия" Tag="CenterLine"/>
                                </ComboBox>

                                <Button x:Name="ApplyAndRegenerateButton" 
                                    Content="Применить параметры и перегенерировать" 
                                    Click="ApplyAndRegenerateButton_Click"
                                    Margin="5"
                                    Style="{StaticResource ModernButton}"
                                    ToolTip="Применяет все параметры и перегенерирует текст с новым шагом точек"/>
                                </StackPanel>
                        </GroupBox>




                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Масштаб:" Grid.Row="0" Grid.Column="0" Margin="0,5"/>
                            <TextBox x:Name="SvgScaleTextBox" Grid.Row="0" Grid.Column="1" Text="1.0" Margin="0,5"/>

                            <TextBlock Text="Шаг (мм):" Grid.Row="1" Grid.Column="0" Margin="0,5"/>
                            <TextBox x:Name="SvgStepTextBox" Grid.Row="1" Grid.Column="1" Text="5.0" Margin="0,5"/>

                            <TextBlock Text="Высота Z (мм):" Grid.Row="2" Grid.Column="0" Margin="0,5"/>
                            <TextBox x:Name="SvgZTextBox" Grid.Row="2" Grid.Column="1" Text="50.0" Margin="0,5"/>

                            <TextBlock Text="Смещение X:" Grid.Row="3" Grid.Column="0" Margin="0,5"/>
                            <TextBox x:Name="SvgOffsetXTextBox" Grid.Row="3" Grid.Column="1" Text="0" Margin="0,5"/>

                            <TextBlock Text="Смещение Y:" Grid.Row="4" Grid.Column="0" Margin="0,5"/>
                            <TextBox x:Name="SvgOffsetYTextBox" Grid.Row="4" Grid.Column="1" Text="0" Margin="0,5"/>

                            <TextBlock Text="Поворот (град):" Grid.Row="5" Grid.Column="0" Margin="0,5"/>
                            <TextBox x:Name="SvgRotationTextBox" Grid.Row="5" Grid.Column="1" Text="0" Margin="0,5"/>
                        </Grid>

                        <Button x:Name="ApplySvgParametersButton"
                                Content="Применить параметры SVG"
                                Style="{StaticResource ModernButton}"
                                Margin="0,0,0,10"
                                Click="ApplySvgParametersButton_Click"/>

                        <TextBlock Text="Перемещение модели (последней загруженной)" 
                                FontSize="14" 
                                FontWeight="SemiBold" 
                                Margin="0,0,0,10"
                                Foreground="#333"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Смещение X:" Grid.Row="0" Grid.Column="0" Margin="0,5"/>
                            <TextBox x:Name="ModelOffsetXTextBox" Grid.Row="0" Grid.Column="1" Text="0" Margin="0,5"/>

                            <TextBlock Text="Смещение Y:" Grid.Row="1" Grid.Column="0" Margin="0,5"/>
                            <TextBox x:Name="ModelOffsetYTextBox" Grid.Row="1" Grid.Column="1" Text="0" Margin="0,5"/>

                            <TextBlock Text="Смещение Z:" Grid.Row="2" Grid.Column="0" Margin="0,5"/>
                            <TextBox x:Name="ModelOffsetZTextBox" Grid.Row="2" Grid.Column="1" Text="0" Margin="0,5"/>
                        </Grid>

                        <Button Content="Применить смещение" 
                                x:Name="ApplyModelOffsetButton" 
                                Style="{StaticResource ModernButton}"
                                Click="ApplyModelOffsetButton_Click"/>

                        <Button Content="Создать УП" 
                                x:Name="ExportUPProgramm" 
                                Style="{StaticResource ModernButton}"
                                Margin="0,20,0,0"
                                Click="ExportUPProgrammButton_Click"/>


                        <GroupBox Header="Настройки экспорта УП" Margin="0,10,0,0">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Имя программы:" VerticalAlignment="Center" Margin="5"/>
                                    <TextBox x:Name="ProgramNameTextBox" Grid.Column="1" Text="" Margin="5"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Комментарий:" VerticalAlignment="Center" Margin="5"/>
                                    <TextBox x:Name="ProgramCommentTextBox" Grid.Column="1" Text="" Margin="5"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Скорость (mm/sec):" VerticalAlignment="Center" Margin="5"/>
                                    <TextBox x:Name="SpeedTextBox" Grid.Column="1" Text="250" Margin="5"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Режим движения:" VerticalAlignment="Center" Margin="5"/>
                                    <ComboBox x:Name="MotionTypeComboBox" Grid.Column="1" Margin="5">
                                        <ComboBoxItem Content="CNT40 (плавно)" Tag="CNT40"/>
                                        <ComboBoxItem Content="CNT60 (очень плавно)" Tag="CNT60" IsSelected="True"/>
                                        <ComboBoxItem Content="CNT100 (максимально плавно)" Tag="CNT100"/>
                                        <ComboBoxItem Content="FINE (точно)" Tag="FINE"/>
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </GroupBox>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>