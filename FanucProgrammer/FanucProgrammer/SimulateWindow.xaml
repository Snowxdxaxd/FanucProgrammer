<Window x:Class="FanucProgrammer.SimulateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="3D Симуляция - Fanuc Programmer" Height="850" Width="1400"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">
    <Window.Resources>
        <!-- Modern Button Style -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#A52A2A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="4" 
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect Color="#40000000" Direction="270" ShadowDepth="2" BlurRadius="4" Opacity="0.3"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#A52A2A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#800000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Primary Button Style -->
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#A52A2A"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="4" 
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect Color="#40000000" Direction="270" ShadowDepth="2" BlurRadius="4" Opacity="0.3"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#A52A2A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#800000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Card Style -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#20000000" Direction="270" ShadowDepth="3" BlurRadius="8" Opacity="0.2"/>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Modern TextBox Style -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#2196F3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Modern TabControl Style -->
        <Style x:Key="ModernTabControl" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        
        <Style x:Key="ModernTabItem" TargetType="TabItem">
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border Name="Border" 
                               Background="Transparent" 
                               BorderThickness="0"
                               Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" 
                                            HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#A52A2A"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#E3F2FD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <Border Grid.Row="0" Background="#FF8C00" Padding="20,15">
            <TextBlock Text="3D Симуляция траектории робота" 
                      FontSize="24" 
                      FontWeight="Bold" 
                      Foreground="White"/>
        </Border>
        
        <TabControl x:Name="TabControl" 
                   Grid.Row="1"
                   Style="{StaticResource ModernTabControl}">
            <!-- Tab 1: Program Load -->
            <TabItem Header="Загрузка программы" Style="{StaticResource ModernTabItem}">
                <Border Style="{StaticResource Card}" Margin="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <Button Content="Загрузить программу" 
                               x:Name="LoadButton" 
                               Style="{StaticResource PrimaryButton}"
                               Grid.Row="0"
                               Margin="0,0,0,15"
                               Click="LoadButton_Click"/>
                        
                        <Border Grid.Row="1" 
                               Background="#1E1E1E" 
                               CornerRadius="4" 
                               Padding="15"
                               BorderThickness="1"
                               BorderBrush="#333"
                               Margin="0,0,0,15">
                            <ListBox x:Name="ProgramListBox" 
                                    Background="Transparent"
                                    Foreground="#D4D4D4"
                                    BorderThickness="0"
                                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                                    FontFamily="Consolas" 
                                    FontSize="11"/>
                        </Border>
                        
                        <Button Content="Выписать координаты точек" 
                               x:Name="ExtractCoordinatesButton" 
                               Style="{StaticResource ModernButton}"
                               Grid.Row="2"
                               Click="ExtractCoordinatesButton_Click"/>
                    </Grid>
                </Border>
            </TabItem>
            
            <!-- Tab 2: 3D Visualization -->
            <TabItem Header="Эмуляция" Style="{StaticResource ModernTabItem}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="280"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- 3D Viewport -->
                    <Border Grid.Column="0" 
                           Background="#1A1A1A" 
                           Margin="10,10,5,10"
                           CornerRadius="8"
                           BorderThickness="1"
                           BorderBrush="#333">
                        <Border.Effect>
                            <DropShadowEffect Color="#40000000" Direction="270" ShadowDepth="3" BlurRadius="8" Opacity="0.3"/>
                        </Border.Effect>
                        <Viewport3D x:Name="Viewport3D">
                            <Viewport3D.Camera>
                                <PerspectiveCamera x:Name="Camera" 
                                                 Position="0,0,800" 
                                                 LookDirection="0,0,-1" 
                                                 UpDirection="0,1,0" 
                                                 FieldOfView="45"/>
                            </Viewport3D.Camera>
                            
                            <ModelVisual3D>
                                <ModelVisual3D.Content>
                                    <Model3DGroup x:Name="SceneGroup">
                                        <!-- Lighting -->
                                        <AmbientLight Color="#CCCCCC"/>
                                        <DirectionalLight Color="White" Direction="-1,-1,-1"/>
                                        <DirectionalLight Color="#888888" Direction="1,1,-1"/>
                                    </Model3DGroup>
                                </ModelVisual3D.Content>
                            </ModelVisual3D>
                        </Viewport3D>
                    </Border>
                    
                    <!-- Controls Panel -->
                    <Border Grid.Column="1" 
                           Style="{StaticResource Card}"
                           Margin="5,10,10,10">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Координаты точки" 
                                          FontSize="16" 
                                          FontWeight="Bold" 
                                          Margin="0,0,0,15"
                                          Foreground="#333"/>
                                
                                <TextBlock Text="X:" 
                                          FontWeight="SemiBold" 
                                          Margin="0,0,0,5"/>
                                <TextBox x:Name="XTextBox" 
                                        Style="{StaticResource ModernTextBox}"
                                        Margin="0,0,0,15"/>
                                
                                <TextBlock Text="Y:" 
                                          FontWeight="SemiBold" 
                                          Margin="0,0,0,5"/>
                                <TextBox x:Name="YTextBox" 
                                        Style="{StaticResource ModernTextBox}"
                                        Margin="0,0,0,15"/>
                                
                                <TextBlock Text="Z:" 
                                          FontWeight="SemiBold" 
                                          Margin="0,0,0,5"/>
                                <TextBox x:Name="ZTextBox" 
                                        Style="{StaticResource ModernTextBox}"
                                        Margin="0,0,0,20"/>
                                
                                <Button Content="➕ Добавить точку" 
                                       x:Name="AddPointButton" 
                                       Style="{StaticResource PrimaryButton}"
                                       Margin="0,0,0,10"
                                       Click="AddPointButton_Click"/>

                                <Button Content="Очистить симуляцию" 
                                       x:Name="ClearSimulationButton" 
                                       Style="{StaticResource ModernButton}"
                                       Margin="0,0,0,20"
                                       Click="ClearSimulationButton_Click"/>
                                
                                <TextBlock Text="Список координат" 
                                          FontSize="16" 
                                          FontWeight="Bold" 
                                          Margin="0,0,0,10"
                                          Foreground="#333"/>
                                <Border Background="#F9F9F9" 
                                       CornerRadius="4" 
                                       BorderThickness="1"
                                       BorderBrush="#E0E0E0"
                                       Height="200"
                                       Margin="0,0,0,20">
                                    <ListBox x:Name="CoordinatesListBox" 
                                            Background="Transparent"
                                            BorderThickness="0"
                                            FontFamily="Consolas"
                                            FontSize="11"/>
                                </Border>
                                
                                <TextBlock Text="Управление камерой" 
                                          FontSize="16" 
                                          FontWeight="Bold" 
                                          Margin="0,0,0,15"
                                          Foreground="#333"/>
                                
                                <TextBlock Text="Поворот по оси X:" 
                                          FontWeight="SemiBold" 
                                          Margin="0,0,0,5"/>
                                <Slider x:Name="RotationXSlider" 
                                       Minimum="0" 
                                       Maximum="360" 
                                       Value="0" 
                                       TickFrequency="10"
                                       ValueChanged="RotationXSlider_ValueChanged"
                                       Margin="0,0,0,20"/>
                                
                                <TextBlock Text="Поворот по оси Y:" 
                                          FontWeight="SemiBold" 
                                          Margin="0,0,0,5"/>
                                <Slider x:Name="RotationYSlider" 
                                       Minimum="0" 
                                       Maximum="360" 
                                       Value="0" 
                                       TickFrequency="10"
                                       ValueChanged="RotationYSlider_ValueChanged"
                                       Margin="0,0,0,20"/>
                                
                                <TextBlock Text="Используйте WASD для перемещения камеры" 
                                          FontSize="11" 
                                          Foreground="#666"
                                          TextWrapping="Wrap"
                                          Margin="0,0,0,15"/>
                                
                                <Button Content="Обновить сцену" 
                                       x:Name="RefreshButton" 
                                       Style="{StaticResource ModernButton}"
                                       Margin="0,0,0,15"
                                       Click="RefreshButton_Click"/>

                                <!-- Загрузка / удаление 3D моделей -->
                                <TextBlock Text="3D модели" 
                                          FontSize="16" 
                                          FontWeight="Bold" 
                                          Margin="0,0,0,10"
                                          Foreground="#333"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Button Content="Загрузить 3D модель" 
                                            x:Name="LoadModelButton" 
                                            Style="{StaticResource ModernButton}"
                                            Margin="0,0,10,0"
                                            Click="LoadModelButton_Click"/>
                                    <Button Content="Удалить 3D модели" 
                                            x:Name="ClearModelsButton" 
                                            Style="{StaticResource ModernButton}"
                                            Click="ClearModelsButton_Click"/>
                                </StackPanel>

                                <TextBlock Text="Перемещение модели (последней загруженной)" 
                                          FontSize="14" 
                                          FontWeight="SemiBold" 
                                          Margin="0,0,0,10"
                                          Foreground="#333"/>

                                <TextBlock Text="Смещение X:" 
                                          FontWeight="SemiBold" 
                                          Margin="0,0,0,5"/>
                                <TextBox x:Name="ModelOffsetXTextBox" 
                                        Style="{StaticResource ModernTextBox}"
                                        Margin="0,0,0,10"
                                        Text="0"/>

                                <TextBlock Text="Смещение Y:" 
                                          FontWeight="SemiBold" 
                                          Margin="0,0,0,5"/>
                                <TextBox x:Name="ModelOffsetYTextBox" 
                                        Style="{StaticResource ModernTextBox}"
                                        Margin="0,0,0,10"
                                        Text="0"/>

                                <TextBlock Text="Смещение Z:" 
                                          FontWeight="SemiBold" 
                                          Margin="0,0,0,5"/>
                                <TextBox x:Name="ModelOffsetZTextBox" 
                                        Style="{StaticResource ModernTextBox}"
                                        Margin="0,0,0,10"
                                        Text="0"/>

                                <Button Content="Применить смещение" 
                                       x:Name="ApplyModelOffsetButton" 
                                       Style="{StaticResource ModernButton}"
                                       Click="ApplyModelOffsetButton_Click"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
